<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.starrysky.MFanControlHelper</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Library/PrivilegedHelperTools/MFanControlHelper</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>MFANCONTROL_USE_XPC</key>
      <string>1</string>
      <key>MFANCONTROL_LOG_LEVEL</key>
      <string>info</string>
    </dict>
    <key>MachServices</key>
    <dict>
      <key>com.starrysky.MFanControlHelper.xpc</key>
      <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/mfancontrol-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/mfancontrol-helper.err</string>
  </dict>
</plist>
